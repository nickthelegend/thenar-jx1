<?xml version="1.0"?>
<package format="3">
  <name>jx1_sim</name>
  <version>0.1.0</version>
  <description>MuJoCo simulator node for JX1: publishes /clock, /jx1/joint_states, /jx1/imu, /jx1/odom and applies /jx1/joint_command position targets.</description>
  <maintainer email="maintainer@jx1.invalid">JX1 project</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- mujoco: pip install mujoco==3.14.0 -->
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
