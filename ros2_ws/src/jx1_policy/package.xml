<?xml version="1.0"?>
<package format="3">
  <name>jx1_policy</name>
  <version>0.1.0</version>
  <description>Runs the exported JX1 walking policy (ONNX + policy_io.yaml) on /jx1/joint_states + /jx1/imu + /cmd_vel and publishes joint position targets.</description>
  <maintainer email="maintainer@jx1.invalid">JX1 project</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- onnxruntime: pip install onnxruntime (no rosdep key on all platforms) -->
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
