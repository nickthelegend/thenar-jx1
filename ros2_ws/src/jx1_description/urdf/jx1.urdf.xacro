<?xml version="1.0"?>
<!-- JX1 humanoid (xacro). Generated by tools/sim/build_robot_description.py from the SolidWorks CAD.
     Default arguments expand to jx1.urdf. Example: xacro jx1.urdf.xacro collision:=visual limit_margin_deg:=2 -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="jx1">
  <xacro:arg name="mesh_prefix" default="package://jx1_description/meshes"/>
  <xacro:arg name="collision" default="hulls"/>          <!-- hulls: CoACD convex parts | visual: visual mesh | none -->
  <xacro:arg name="limit_margin_deg" default="0"/>       <!-- soft-limit margin: shrinks every joint range at both ends -->
  <xacro:arg name="damping" default="0.05"/>
  <xacro:arg name="friction" default="0.3"/>
  <xacro:property name="mp" value="$(arg mesh_prefix)"/>
  <xacro:property name="col" value="$(arg collision)"/>
  <xacro:property name="margin" value="${float($(arg limit_margin_deg)) * pi / 180.0}"/>
  <!-- actuator classes (actuators/actuator_catalog.yaml): peak torque N m, max speed rad/s -->
  <xacro:property name="effort_ANKLE_P" value="46.0"/>
  <xacro:property name="velocity_ANKLE_P" value="30.0"/>
  <xacro:property name="effort_ANKLE_R" value="51.0"/>
  <xacro:property name="velocity_ANKLE_R" value="30.0"/>
  <xacro:property name="effort_L" value="60.0"/>
  <xacro:property name="velocity_L" value="20.9"/>
  <xacro:property name="effort_M" value="36.0"/>
  <xacro:property name="velocity_M" value="50.3"/>
  <xacro:property name="effort_S" value="17.0"/>
  <xacro:property name="velocity_S" value="44.0"/>
  <xacro:property name="effort_SERVO" value="1.9"/>
  <xacro:property name="velocity_SERVO" value="4.7"/>
  <xacro:property name="effort_XL" value="120.0"/>
  <xacro:property name="velocity_XL" value="20.9"/>
  <xacro:property name="effort_XS" value="14.0"/>
  <xacro:property name="velocity_XS" value="33.0"/>

  <xacro:macro name="jx1_link" params="name mass com ixx ixy ixz iyy iyz izz visual **hulls">
    <link name="${name}">
      <inertial>
        <origin xyz="${com}" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia ixx="${ixx}" ixy="${ixy}" ixz="${ixz}" iyy="${iyy}" iyz="${iyz}" izz="${izz}"/>
      </inertial>
      <visual><geometry><mesh filename="${mp}/${visual}"/></geometry></visual>
      <xacro:if value="${col == 'visual'}"><collision><geometry><mesh filename="${mp}/${visual}"/></geometry></collision></xacro:if>
      <xacro:if value="${col == 'hulls'}"><xacro:insert_block name="hulls"/></xacro:if>
    </link>
  </xacro:macro>

  <xacro:macro name="jx1_joint" params="name parent child xyz axis lower upper effort velocity">
    <joint name="${name}" type="revolute">
      <parent link="${parent}"/>
      <child link="${child}"/>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <axis xyz="${axis}"/>
      <limit lower="${lower + margin}" upper="${upper - margin}" effort="${effort}" velocity="${velocity}"/>
      <dynamics damping="$(arg damping)" friction="$(arg friction)"/>
    </joint>
  </xacro:macro>

  <xacro:jx1_link name="pelvis" mass="2.97711" com="-0.000197 0.000099 0.122770" ixx="2.378231e-02" ixy="-5.483974e-08" ixz="1.387359e-07" iyy="5.679341e-03" iyz="-6.367113e-06" izz="2.631614e-02" visual="pelvis.stl">
